# secrets - NEVER commit these
.env
*.env
!.env.example
secrets.json
*.pem
*.key

# duckdb is rebuildable from committed parquet - never commit the binary
*.duckdb
*.duckdb.wal

# raw downloads (rebuildable, large)
data/raw/*
!data/raw/.gitkeep

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# os / editor
.DS_Store
Thumbs.db
.vscode/

# local previews and run logs
preview_*.html
*.log

# scratch
.scratch_fs/

# fundamentals: large, regenerable from NSE, and rewritten on every backfill pass
data/financials/legacy_missing.parquet

# duckdb spill files and backfill error logs
.tmp/
*.err

# study panels: large, rebuilt by the scripts in jobs/
data/study/*.parquet

# Third-party index and factor data: free to download, not ours to redistribute.
# data/external/SOURCES.md says where each came from and how to fetch it again.
data/external/niftyindices/
data/external/nifty_tri.parquet
data/external/iima/*.csv
data/indices/derived/

# Backtest working output: rebuilt by jobs/backtest_v1.py in about two minutes.
data/backtest/v1/ranks.parquet
data/backtest/v1_holdout/ranks.parquet
data/study/crosscheck_iima/
data/backtest/v1_corrected/ranks.parquet

# Local copy of every downloaded XBRL filing (zen/data/xbrl_cache.py): large
# and regenerable from NSE, kept so a parser fix can re-read from disk.
data/raw_xbrl/

# Re-parse working copies and the pre-swap backup (2026-09-24): kept locally, not in git.
data/financials_staging/
data/financials_backup_*/
