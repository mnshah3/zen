# secrets - NEVER commit these
.env
*.env
!.env.example
secrets.json
*.pem
*.key

# duckdb is rebuildable from committed parquet - never commit the binary
*.duckdb
*.duckdb.wal

# raw downloads (rebuildable, large)
data/raw/*
!data/raw/.gitkeep

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# os / editor
.DS_Store
Thumbs.db
.vscode/

# local previews and run logs
preview_*.html
*.log

# scratch
.scratch_fs/

# fundamentals: large, regenerable from NSE, and rewritten on every backfill pass
data/financials/legacy_missing.parquet

# duckdb spill files and backfill error logs
.tmp/
*.err

# study panels: large, rebuilt by the scripts in jobs/
data/study/*.parquet
data/cache/

# Third-party index and factor data: free to download, not ours to redistribute.
# data/external/SOURCES.md says where each came from and how to fetch it again.
data/external/niftyindices/
data/external/nifty_tri.parquet
data/external/nifty_price_endpoints.csv
data/external/iima/*.csv
data/indices/derived/

# Backtest working output: rebuilt by jobs/backtest_v1.py in about two minutes.
data/backtest/v1/ranks.parquet
data/backtest/v1_holdout/ranks.parquet
data/study/crosscheck_iima/
data/backtest/v1_corrected/ranks.parquet
data/backtest/v1_final/ranks.parquet

# Local copy of every downloaded XBRL filing (zen/data/xbrl_cache.py): large
# and regenerable from NSE, kept so a parser fix can re-read from disk.
data/raw_xbrl/

# Re-parse working copies and the pre-swap backup (2026-09-24): kept locally, not in git.
data/financials_staging/
data/financials_backup_*/
data/backtest/v2*/ranks.parquet

# v3's frozen inputs (spec 15.2.4): copies of ignored or large files. Only the hash list is kept.
data/frozen/v3/*
!data/frozen/v3/freeze.json

# The v1 replay on the frozen inputs (spec 14.2): working ranks, rebuilt by jobs/backtest_v1.py.
data/backtest/v1_replay_v3/ranks.parquet
data/backtest/v1_window_2020/ranks.parquet

# v3 development runs (agreement period, comparisons): rebuilt by jobs/backtest_v3.py and
# jobs/crosscheck_v3.py from the frozen inputs. The final run folder is committed, these are not.
data/backtest/v3_dev/
data/backtest/v3_dev_check/
data/backtest/v1_final_window_2020/ranks.parquet

# v3 run: the working tables the engine rebuilds (jobs/backtest_v3.py); the CSV records are committed
data/backtest/v3/figures.parquet
data/backtest/v3/ranks.parquet

# BSE data stays on the machine that fetched it: BSE prohibits reproducing or redistributing it
data/bse_announcements/
data/bse_results/
# AMFI's terms: personal use only, no publishing; zen-portfolios (private) keeps the NAVs
data/mf_nav/
